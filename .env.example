# Google service account (copy these from your downloaded service-account JSON)
GOOGLE_CLIENT_EMAIL=pg-booking@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Google Sheet used as PG Booking database
GOOGLE_SHEET_ID=your_google_sheet_id

# Main Drive folder used by PG Booking
GOOGLE_DRIVE_FOLDER_ID=your_main_drive_folder_id

# Long random string used to sign login session cookies
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# StayFinder transactional email / password reset (Gmail SMTP)
MAIL_USER=yourgmail@gmail.com
MAIL_APP_PASSWORD=your_16_character_google_app_password
MAIL_FROM_NAME=StayFinder
SUPPORT_EMAIL=your_support_email@gmail.com
NEXT_PUBLIC_APP_URL=https://stayfinder-pg-booking.vercel.app
